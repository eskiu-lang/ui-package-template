// The demo: the battery's charge, from <mypackage>. `ui run ios` (or android, web).
import <string>;
import <ui>;
import <ui/kit>;
import <mypackage>;

void Demo() {
    Column(Style{grow: 1, padding: 24, gap: 16, justify: JustifyCenter, background: kit.page}) {
        Battery battery = use_battery();
        Card() {
            Secondary("Battery");
            String text;
            defer String_free(&text);
            if (battery.level < 0) { String_from(&text, "Unknown"); }
            else { String_format(&text, "%d%%", battery.level); }
            TextWith(Style{font_size: 48, font_weight: 800, color: kit.ink}, text.data);
            if (battery.level >= 0) { ProgressBar(battery.level, 100); }
            Secondary(battery.charging ? "Charging" : "On battery");
        }
    }
}

void ui_app_start(int which) {
    kit_follow_system();
    ui_mount() { Demo(); }
}

void ui_app_stop() {}
